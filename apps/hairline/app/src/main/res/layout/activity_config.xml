<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="28dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:text="@string/config_title"
            android:textColor="@color/config_text"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/config_subtitle"
            android:textColor="@color/config_text_dim"
            android:textSize="13sp" />

        <!-- Location -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_location" />

        <RadioGroup
            android:id="@+id/radio_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_loc_auto"
                style="@style/Choice"
                android:text="@string/location_auto" />

            <RadioButton
                android:id="@+id/radio_loc_manual"
                style="@style/Choice"
                android:text="@string/location_manual" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/row_manual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/edit_place"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints="postalAddress"
                android:hint="@string/location_hint"
                android:imeOptions="actionSearch"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:textColor="@color/config_text"
                android:textColorHint="@color/config_text_dim" />

            <Button
                android:id="@+id/btn_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:text="@string/location_search" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_place_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/config_text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/text_permission_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/permission_needed"
            android:textColor="@color/config_text_dim"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_permission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/permission_grant"
            android:visibility="gone" />

        <!-- Look -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_look" />

        <RadioGroup
            android:id="@+id/radio_unit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_celsius"
                style="@style/Choice"
                android:layout_marginEnd="24dp"
                android:text="@string/unit_celsius" />

            <RadioButton
                android:id="@+id/radio_fahrenheit"
                style="@style/Choice"
                android:text="@string/unit_fahrenheit" />
        </RadioGroup>

        <RadioGroup
            android:id="@+id/radio_icons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_icons_colour"
                style="@style/Choice"
                android:layout_marginEnd="24dp"
                android:text="@string/icons_colour" />

            <RadioButton
                android:id="@+id/radio_icons_mono"
                style="@style/Choice"
                android:text="@string/icons_mono" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/hours_label"
            android:textColor="@color/config_text_dim"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinner_hours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

        <CheckBox
            android:id="@+id/check_precip"
            style="@style/Choice"
            android:layout_marginTop="8dp"
            android:text="@string/show_precip" />

        <!-- Tap target -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_tap" />

        <RadioGroup
            android:id="@+id/radio_tap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_tap_windy"
                style="@style/Choice"
                android:text="@string/tap_windy" />

            <RadioButton
                android:id="@+id/radio_tap_ventusky"
                style="@style/Choice"
                android:text="@string/tap_ventusky" />

            <RadioButton
                android:id="@+id/radio_tap_browser"
                style="@style/Choice"
                android:text="@string/tap_browser" />

            <RadioButton
                android:id="@+id/radio_tap_none"
                style="@style/Choice"
                android:text="@string/tap_none" />
        </RadioGroup>

        <TextView
            android:id="@+id/text_tap_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tap_missing_app"
            android:textColor="@color/config_text_dim"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Actions -->
        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/config_text_dim"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/action_refresh" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_save" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/add_widget_hint"
            android:textColor="@color/config_text_dim"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/credit"
            android:textColor="@color/config_text_dim"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
